# 大蒜播种车 Rover 4.7.2 / X-MAV AP-H743v3 基础参数 (Mission Planner / MAVProxy 格式: 名称,值)
# 导入方式: Mission Planner "全部参数表 -> 加载"; 或 MAVProxy "param load garlic_rover.param"
# 几何和速度已按实车填写 (10-18 甲方回复 + 整车模型). 现场仍可能要调的: TURN_RADIUS (实测后)、PSC_POS_P/PSC_VEL_*、
#   WP_RADIUS、ATC_ACCEL_MAX/ATC_DECEL_MAX、ATC_STR_ACC_MAX.
#   调参时对比日志 THR.DesSpeed / STER.DesTurnRate (期望) 与 VCU.V / VCU.W (底盘实际), 压线看 NTUN.XTrack.
# 标 [固定] 的参数不要改, 原因写在各自的注释里.
# 带 [重启] 的参数修改后需重启飞控.
# 必须加载两遍: SCR_ENABLE、CAN_P2_DRIVER 是"总开关", 为 0 时同组的 SCR_HEAP_SIZE、CAN_P2_BITRATE 被隐藏,
#   第一遍会提示 missing. 第一遍写入并重启后再加载写入一遍即可.
#   VCU_* 参数在 vcu_can.lua 第一次运行并重启后才出现, 第一遍也会提示 missing, 属正常.

# ---------- 车型 ----------
FRAME_CLASS,1
# [固定] 阿克曼底盘不能原地转向, 必须为 0
WP_PIVOT_ANGLE,0
# 上电默认 HOLD(4), 不用默认的 MANUAL
INITIAL_MODE,4
# 最小转弯半径(m): 等效轴距 1.2 m、前辊最大摆角 30 度的理论值 1.2/tan30 = 2.08 m;
#   vcu_can.lua 按 atan(VCU_W_BASE/TURN_RADIUS) 限前辊转角, 2.1 对应约 29.7 度. 实测最小转弯半径后替换
TURN_RADIUS,2.1

# ---------- 脚本 + CAN (CAN1 保留给 DroneCAN, CAN2 接 VCU) ----------
# [重启]
SCR_ENABLE,1
SCR_HEAP_SIZE,204800
CAN_P1_DRIVER,1
CAN_D1_PROTOCOL,1
# [固定][重启] CAN2 -> 驱动2 -> 脚本协议(10): CAN2 交给 Lua 脚本 (vcu_can.lua) 收发 VCU 帧;
#   改成其它协议后脚本拿不到 CAN 口 (报 "VCU: no scripting CAN"), 不再给 VCU 发指令
CAN_P2_DRIVER,2
CAN_D2_PROTOCOL,10
# [重启] 与 VCU 一致: 250000 / 500000
CAN_P2_BITRATE,500000

# ---------- 航点导航 ----------
# 作业速度(m/s): 播种/行驶速度 2 km/h = 0.556 m/s
WP_SPEED,0.55
CRUISE_SPEED,0.55
# 到点判定半径(m), 有 RTK 时可取 0.3~0.5
WP_RADIUS,0.5
WP_ACCEL,0.5
WP_JERK,1.0
# 速度上限(m/s), 显式设置; 0 表示由 CRUISE_* 推算, 与 VCU 不相符. 与 VCU_V_MAX 保持一致
#   甲方给的最高安全车速 5 km/h = 1.389 m/s, 取略小
SPEED_MAX,1.38
# 返航速度, 0=用 WP_SPEED
RTL_SPEED,0
# 任务结束后: 0=HOLD
MIS_DONE_BEHAVE,0
# 航点存 SD 卡(KB), 约 15 字节/航点, 64KB 约 4000 点  [重启]
BRD_SD_MISSION,64

# ---------- 控制器限幅 (决定下发给 VCU 的 v/w 的范围和变化率) ----------
ATC_ACCEL_MAX,0.5
ATC_DECEL_MAX,0.8
# 角速度上限(deg/s)
ATC_STR_RAT_MAX,45
# 角加速度上限(deg/s/s), 限制 w 的变化率, 避免转向机构跟不上
ATC_STR_ACC_MAX,60
ATC_STR_DEC_MAX,60
# 最大横向加速度(G), 低速农机取小值
ATC_TURN_MAX_G,0.15

# ---------- 占位输出 (ArduPilot 需要转向/油门通道, 实际不接线, 由 VCU 执行) ----------
SERVO1_FUNCTION,26
SERVO3_FUNCTION,70
MOT_SPD_SCA_BASE,0
MOT_SLEWRATE,0

# ---------- [固定] 内部转向/速度 PID: 设为纯前馈, 防止占位输出饱和 ----------
# 原因: 转向/油门输出不接执行机构, 若保留 P/I, 积分会一直累积到饱和;
#   转向饱和会置 "转向到极限" 标志, 位置控制器 (AR_PosControl) 据此停止该方向的纠偏, 压线变差;
#   油门输出还被碰撞检测 (FS_CRASH_CHECK) 使用, 纯前馈时它与期望速度成正比, 判断才可靠.
# 纯前馈后: 转向输出 = 0.2 x w(rad/s), w 最大 45deg/s=0.785 -> 0.16, 不会饱和
ATC_STR_RAT_P,0
ATC_STR_RAT_I,0
ATC_STR_RAT_D,0
ATC_STR_RAT_IMAX,0
ATC_STR_RAT_FF,0.2
# 油门输出 = v x CRUISE_THROTTLE/100 / CRUISE_SPEED; v 最大 1.38 -> 1.38 x 0.35 / 0.55 = 88%, 不饱和
#   (CRUISE_THROTTLE 保持 50 时 v > 1.1 m/s 就超过 100%)
# ATC_SPEED_P 允许范围 0.01~2, 取最小值 0.01 (影响可忽略); 关键是 I=0 不累积
ATC_SPEED_P,0.01
ATC_SPEED_I,0
ATC_SPEED_D,0
ATC_SPEED_IMAX,0
ATC_SPEED_FF,0
CRUISE_THROTTLE,35

# ---------- 失控保护 ----------
# 1=RTL 2=HOLD, 农田作业建议 HOLD
FS_ACTION,2
FS_TIMEOUT,1.5
# 地面站断链保护: 2 = Auto 模式下断链继续跑完航线, 其他模式按 FS_ACTION 停车.
# 与地面站断线告警"车辆仍在按航线自动作业"一致; 4G 信号时好时坏, 设 1 会频繁停车.
# 作业中的安全由 VCU/RTK 检查 (vcu_can.lua)、陷车检测和车上硬件急停回路保证 (本车不用电子围栏).
FS_GCS_ENABLE,2
FS_GCS_TIMEOUT,5
# 电子围栏: 本车不用, 显式关闭 (garlic.5 及以前的参数设过 FENCE_ENABLE=1, 加载本文件会把它关掉)
FENCE_ENABLE,0
# 若没有 ArduPilot 端遥控接收机(遥控直接接 VCU), 关闭遥控失控检测
FS_THR_ENABLE,0
# 碰撞/卡死检测: 有油门需求但车速 < CRASH_VEL_MIN 持续 CRASH_TIMEOUT 秒 -> HOLD (陷车、VCU 不执行时停车)
FS_CRASH_CHECK,1
CRASH_THR_MIN,10
CRASH_VEL_MIN,0.08
CRASH_TIMEOUT,3
FS_EKF_ACTION,1

# ---------- 解锁检查 ----------
# 飞控不接遥控接收机 (遥控直接接 VCU): 跳过 RC 检查. 64 = AP_Arming::Check::RC, 其他解锁检查不受影响
ARMING_SKIPCHK,64
ARMING_NEED_LOC,1
# 安全开关: AP-H743v3 没有安全开关, 设 0 表示上电即可解锁 (仍需通过各项解锁检查)  [重启]
BRD_SAFETY_DEFLT,0

# ---------- 串口分配 ----------
# SERIAL1 (USART2) = MAVLink2 -> 接数传电台 / 4G 模块
# 板子默认 57600, 必须与 4G DTU (EP-D200) 一致, 否则 4G 完全不通
SERIAL1_BAUD,115
# [重启] GPS 口 (SERIAL3/USART1, 板上标 GPS) 接 UM982; 与模块约定固定 230400, 模块侧配置见台架测试手册 C0
SERIAL3_BAUD,230
# 以下为 AP-H743v3 默认值, 不用改, 仅作接线说明
# SERIAL2 (UART4)  = MAVLink2 -> 备用数传
# SERIAL6 (USART3) = MSP DisplayPort (DJI 图传口, 本车不用)
# SERIAL7 (UART5)  = RCIN     -> 遥控接收机 (若遥控接 VCU 则此口空闲)

# ---------- 板载 OSD: 本车没有图传, 两路都关闭 ----------
# 本板默认 OSD_TYPE=1 (板载 AT7456E)、OSD_TYPE2=5 (DisplayPort). 必须两路一起关:
#   只关 OSD_TYPE 而 OSD_TYPE2 仍为 5 时, 官方 4.7.1/4.7.2 的 OSD 线程访问空指针, 飞控启动即卡死、USB 连不上
#   (v4.7.1-garlic.3 起固件已修复, garlic.4 起改用官方修复 ArduPilot PR #34497; 参数仍两路都关).
OSD_TYPE2,0
OSD_TYPE,0

# ---------- 定位 (维特智能 WTRTK-982 / UM982 双天线定向) ----------
# [固定] 航向只用 GPS 双天线 (2), 不用磁罗盘 (农机上铁件和电机干扰大, 也免去罗盘校准)
EK3_SRC1_YAW,2
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0
# UM982 双天线 NMEA; 飞控自动下发 UNIHEADINGA/AGRICA 等配置 (GPS_AUTO_CONFIG 保持默认 1)
# 串口固定 230400 (SERIAL3_BAUD=230); 模块侧首次用 UPrecise 固化配置, 命令清单见台架测试手册 C0
GPS1_TYPE,25
# 航向 = 按 GPS1_MB_OFS_* 换算的两天线连线方向 (1 = 使用下面的自定义偏移)
GPS1_MB_TYPE,1
# 天线接线: UM982 主天线口 ANT1 接车身右侧天线, 从天线口 ANT2 接左侧天线; 两天线左右布置、等高, 间距 1.389 m.
# 以下按整车模型测得 (10-18, 单位 m, 前/右/下为正), 装车后用卷尺复核天线间距.
# GPS1_POS_X/Y/Z = 主天线 (ANT1, 右侧) 相对飞控的位置
GPS1_POS_X,0.076
GPS1_POS_Y,0.590
GPS1_POS_Z,-0.019
# GPS1_MB_OFS_X/Y/Z = 主天线 (ANT1) 相对从天线 (ANT2) 的位置 (ArduPilot 定义: 从天线 -> 主天线).
#   主天线在从天线右侧 1.389 m -> GPS1_MB_OFS_Y,1.389
GPS1_MB_OFS_X,0
GPS1_MB_OFS_Y,1.389
GPS1_MB_OFS_Z,0
# 装好后原地转动车身, 确认 HUD 航向与车头方向一致. 本车两天线左右布置 (不是前后):
#   差 180 度说明正负号反了 (ANT1/ANT2 接反), 把 GPS1_MB_OFS_Y 变号 (改为 -1.389) 或对调天线线缆

# ---------- 脚本参数 (首次运行 vcu_can.lua 并重启后才出现) ----------
# 台架测试时如果临时改过 VCU_RTK_REQ、VCU_FB_TMO、FS_CRASH_CHECK、LOG_DISARMED、VCU_DBG_HZ,
#   上车前务必改回 2、200、1、0、0.
#   本节写的就是上车值, 加载本文件即可把这些值一并恢复.
VCU_ENABLE,1
# MotionSta 反馈超时(ms), 0=不检查反馈(台架调试用)
VCU_FB_TMO,200
# 线速度限幅(m/s), 与 SPEED_MAX 保持一致
VCU_V_MAX,1.38
# VCU_W_MAX 已废弃 (Nav v1.0 协议发前轮转角, 不再发角速度), 序号保留勿复用
# 允许倒车: 本期不倒车
VCU_REV,0
# 等效轴距: 前辊转向轴到后辊轴线 1.2 m (整车模型, 装车后卷尺复核), Ackermann 转角换算用
VCU_W_BASE,1.2
# 作业电机启停使能: 1=AUTO 行驶中自动开 (Work_Speed/Dir 协议固定为 0). 本期导航不控制播种, 保持 0
VCU_WORK_EN,0
# 调试量 VCU_CMD_V/W/D、VCU_V/W 上报地面站的频率(Hz), 0=不发 (4G 省流量); 台架调试时设 5
VCU_DBG_HZ,0
# RTK 要求: 0=不检查, 1=浮点解或固定解, 2=仅固定解
VCU_RTK_REQ,2
# RTK 不满足要求持续多久(ms)后停车
VCU_RTK_TMO,3000
# 解锁前也记日志: 0=关 (默认), 台架调试时可能临时设过 1
LOG_DISARMED,0
